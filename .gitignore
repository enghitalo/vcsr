dist/
*.wasm
*.br
*.gz

# ...except small, hand-authored .wasm checked in as test/demo fixtures
# (language-neutral ABI fixtures + the fetch/localStorage demo). These are
# committed so the test/demo run without a wasm toolchain installed.
!tests/fixtures/abi/*.wasm
!docs/examples/webapi-demo/*.wasm

# Keep each app's prebuilt browser-ABI wasm INPUTS (build/) — authored with
# clang/wat2wasm, not generated by vcsr. The dist/ they bundle into IS
# vcsr-generated output and stays ignored (tests regenerate it via build()).
!testdata/**/build/
!testdata/**/build/**

# V build artifacts
*.so
*.o

# vcsr-generated component code (emitted from name.v/.html/.css triplets)
*.gen.v
# ...except the counter example's, committed so the example compiles and its
# integration test (counter_test.v) runs from a clean checkout without first
# running `vcsr gen`. It also shows readers exactly what codegen emits.
!examples/counter/src/counter.gen.v

# built vcsr CLI binary
cmd/vcsr/vcsr
